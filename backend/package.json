{
  "name": "creditbook-api",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "postinstall": "npx prisma generate --schema=../database/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=../database/schema.prisma",
    "db:deploy": "npx prisma migrate deploy --schema=../database/schema.prisma",
    "db:seed": "node src/prisma/seed.js",
    "db:studio": "npx prisma studio --schema=../database/schema.prisma",
    "db:push": "npx prisma db push --schema=../database/schema.prisma",
    "db:generate": "npx prisma generate --schema=../database/schema.prisma",
    "db:push:local": "npx prisma db push --schema=../database/schema.local.prisma"
  },
  "prisma": {
    "schema": "../database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
