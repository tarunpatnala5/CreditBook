# Credit Book API — Environment Variables
# Copy this file to .env and fill in the values
# ⚠️  NEVER put real credentials here — this file is committed to git

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────
# Get both URLs from your Neon project dashboard → Connection Details
# Select "Prisma" connection type to get the correct format
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── JWT Secrets ───────────────────────────────────────────────────────────
# Generate strong random strings:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — use different value for each secret
JWT_ACCESS_SECRET=replace_with_64_char_minimum_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_minimum_random_string
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=365d

# ─── Admin Account ─────────────────────────────────────────────────────────
ADMIN_PHONE=+91XXXXXXXXXX
ADMIN_NAME=Your Name
ADMIN_PASSWORD=your_secure_password

# ─── App Config ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173   # In production: https://your-app.vercel.app
